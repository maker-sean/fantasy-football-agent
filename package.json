{
  "name": "fantasy-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI agent that sustains fantasy football league engagement in the league group chat.",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "m0": "curl -s localhost:3000/m0 | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{const v=JSON.parse(s);console.log(v.notes.join('\\n'));console.table(v.chats)})\"",
    "whoami": "node scripts/whoami.js",
    "capabilities": "node scripts/capabilities.js",
    "groups": "node scripts/groups.js",
    "send": "node scripts/send.js",
    "broadcast": "node scripts/broadcast.js",
    "group-message": "node scripts/group-message.js",
    "inspect": "node scripts/inspect.js",
    "sendblue-preflight": "node scripts/sendblue-preflight.js",
    "sendblue-group": "node scripts/sendblue-group.js",
    "sendblue-status": "node scripts/sendblue-status.js",
    "sendblue-send": "node scripts/sendblue-send.js",
    "simulate": "node scripts/simulate-webhook.js",
    "worker": "node worker.js",
    "snapshot": "node scripts/snapshot.js",
    "register-league": "node scripts/register-league.js",
    "simulate-sendblue": "node scripts/simulate-sendblue.js",
    "sendblue-webhooks": "node scripts/sendblue-webhooks.js",
    "db-check": "node scripts/db-check.js",
    "messages": "node scripts/messages.js",
    "poll": "node scripts/poll.js",
    "sleeper-leagues": "node scripts/sleeper-leagues.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0"
  }
}
