# Blooio API key (dashboard -> API keys)
BLOOIO_API_KEY=

# Optional: seed a league at boot. Leave blank until Milestone 0 tells you the
# real group chat id — M0_MODE observes unregistered chats anyway.
TEST_CHAT_ID=

PORT=3000

# M0_MODE=true accepts inbound from chats we haven't registered yet. Keep this
# on until the group surface is validated; turning it off drops the data M0 needs.
M0_MODE=true

# ECHO=false makes the bot listen silently — useful for a pure-observation pass
# where you don't want the number posting into a real group yet.
ECHO=true

# --- Sendblue (second transport, tested against the same M0 experiment) ---
# Dashboard -> API keys. Both are required.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
# Your Sendblue line — REQUIRED on every send. Get it from `sendblue lines`.
SENDBLUE_FROM_NUMBER=

# Milestone 2
ANTHROPIC_API_KEY=
