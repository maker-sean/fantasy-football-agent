# Blooio API key (dashboard -> API keys)
BLOOIO_API_KEY=

# Optional: seed a league at boot. Leave blank until Milestone 0 tells you the
# real group chat id — M0_MODE observes unregistered chats anyway.
TEST_CHAT_ID=

PORT=3000

# M0_MODE=true accepts inbound from chats we haven't registered yet. Keep this
# on until the group surface is validated; turning it off drops the data M0 needs.
M0_MODE=true

# ECHO=false makes the bot listen silently — useful for a pure-observation pass
# where you don't want the number posting into a real group yet.
ECHO=true

# --- Sendblue (second transport, tested against the same M0 experiment) ---
# Dashboard -> API keys. Both are required.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
# Your Sendblue line — REQUIRED on every send. Get it from `sendblue lines`.
SENDBLUE_FROM_NUMBER=

# Milestone 2
ANTHROPIC_API_KEY=

# Model per surface. Sonnet while tuning voice; bump to claude-opus-4-8 for
# production. Both scripts also take --model for a one-off A/B.
RECAP_MODEL=claude-sonnet-5
ANSWER_MODEL=claude-sonnet-5

# --- Phase 1: Postgres (Supabase) ---
# Supabase -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=

# Timezone for snapshot cron. NFL slates are ET.
CRON_TZ=America/New_York

# --- reply decision ---
# REPLY_DRY_RUN=true decides and logs every burst but never sends.
REPLY_DRY_RUN=true
BURST_QUIET_MS=8000
BURST_MAX_WAIT_MS=30000

# Recap target length in words. ASSUMED, NOT MEASURED — flagged to revisit.
# Short keeps it feeling like a group text; the cost is that real material gets
# dropped from a six-game week. Settle it with reply rate, not taste.
# Words per MESSAGE. A recap may be split into two short texts.
RECAP_WORDS=60

# --- web app (npm run web) ---
# Supabase Auth. Project Settings -> API. The anon key is public by design; it
# is used only to ask Supabase who a browser token belongs to.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Version string recorded when a commissioner accepts the terms. Bump it when
# the terms change and everyone is asked again.
TERMS_VERSION=2026-08-16
# LOCAL ONLY. Skips auth entirely and treats every request as this email.
# Requires NODE_ENV != production. Never set this on a deployed service.
# DEV_AUTH=true
# DEV_AUTH_EMAIL=you@example.com

# --- Linq (second messaging provider — built, not active) ---
# Sendblue remains primary. This exists so migration is an afternoon, not weeks.
LINQ_API_KEY=
LINQ_FROM_NUMBER=
# From the webhook subscription response (whsec_…). Without it, POST
# /webhooks/linq returns 503 rather than accepting unsigned payloads.
LINQ_WEBHOOK_SECRET=

# --- site copy (substituted into the pages at serve time) ---
# Change these when an entity is formed; no code edit or redeploy needed.
SITE_BUSINESS_NAME=Commish AI
SITE_SUPPORT_EMAIL=
SITE_JURISDICTION=the Commonwealth of Virginia
SITE_JURISDICTION_SHORT=Virginia
